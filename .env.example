# ── HomeFind AI — Environment Configuration ──────────────────────────────────

# Required
OPENAI_API_KEY=your_openai_api_key_here

# Optional overrides (defaults shown)
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
OPENAI_STT_MODEL=gpt-transcribe

# Fallback used when the OpenAI key is missing, invalid or out of quota
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=hannah
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Use a long random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Abuse protection (per client IP, per minute; 0 disables)
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_AUDIO_PER_MINUTE=20
# Daily caps on messages that reach the AI (refused off-topic/jailbreak messages are free)
DAILY_CHAT_LIMIT_PER_IP=150
DAILY_CHAT_LIMIT_GLOBAL=3000
# Visitors sending this many jailbreak attempts are locked out for the given minutes
JAILBREAK_STRIKE_LIMIT=5
JAILBREAK_LOCKOUT_MINUTES=15

HOST=0.0.0.0
PORT=7860

LLM_TEMPERATURE=0.3
MAX_PROPERTIES_SHOWN=3
